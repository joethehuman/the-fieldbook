# The amd64 upstream image has no shell. Add a pinned static BusyBox only to
# materialize the database CA before exec-ing the upstream binary.
FROM busybox:1.37.0-musl@sha256:5cec3fc171c87218698e85a52af7087de727372aae264a787b8112901a5b0092 AS shell
FROM postgrest/postgrest:v14.17@sha256:c9dc201e555f5d8e37e7f39cdd4df0229774996e213bfd7de8d10ac609030f2c
COPY --from=shell /bin/busybox /fieldbook-busybox
COPY .do/with-database-ca.sh /fieldbook/with-database-ca.sh
USER 0
RUN ["/fieldbook-busybox", "sh", "-c", "/fieldbook-busybox mkdir -p /tmp && /fieldbook-busybox chmod 1777 /tmp"]
USER 1000
ENTRYPOINT ["/fieldbook-busybox", "sh", "/fieldbook/with-database-ca.sh"]
CMD ["/bin/postgrest"]
