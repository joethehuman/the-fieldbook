NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-server-only-secret-key
FIELDBOOK_URL=https://learn.example.org
FIELDBOOK_OWNER_EMAIL=you@example.com
# Optional identity module; Supabase is the default and only implemented module.
# FIELDBOOK_IDENTITY_PROVIDER=supabase
# Optional: vercel or node. Omit for Vercel auto-detection / ordinary local Node.
# FIELDBOOK_HOST=vercel
# Optional: both Vercel telemetry features default on for the Vercel host.
# Set either to false to disable it; redeploy after changing these values.
# FIELDBOOK_VERCEL_ANALYTICS_ENABLED=false
# FIELDBOOK_VERCEL_SPEED_INSIGHTS_ENABLED=false
# Optional positive integer limit in bytes. Leave blank to use storage limits only.
# Storage-provider and bucket settings determine the available upload size.
FIELDBOOK_UPLOAD_MAX_BYTES=

# Optional preview environment. Vercel detects previews automatically.
# FIELDBOOK_ENVIRONMENT=preview
# Required when using a preview: the separate backend's project reference.
# FIELDBOOK_PREVIEW_SUPABASE_REF=your-test-project-ref
# For a self-hosted preview, declare its exact HTTPS API URL instead of a cloud ref.
# FIELDBOOK_PREVIEW_SUPABASE_URL=https://backend.example.org

# Required for Vercel builds of the installed application.
FIELDBOOK_APP_KIND=installed

# Optional Ask AI; off by default in installation settings.
# Router selection is independent of hosting: vercel or digitalocean.
# Omission keeps vercel for compatibility; none explicitly makes it unavailable.
# FIELDBOOK_AI_ROUTER=vercel
# Vercel Gateway uses project OIDC automatically. Local/alternative credential:
# AI_GATEWAY_API_KEY=your-server-only-gateway-key
# DigitalOcean custom Inference Router. Pools and fallbacks are managed in DO;
# all models need text, tool calling and streaming. See docs/installation.md.
# Model access key must be scoped to the selected router. Discovery uses a separate
# custom token with genai:read and DO-required read-only dependencies.
# Never use a broad deployment token here.
# DIGITALOCEAN_INFERENCE_ROUTER=router:fieldbook
# Attest only exact models tested with forced tools AND streamed Chat Completions.
# DIGITALOCEAN_VERIFIED_MODELS=your-tested-model-id,your-tested-fallback-id
# DIGITALOCEAN_MODEL_ACCESS_KEY=your-server-only-router-model-access-key
# DIGITALOCEAN_ROUTER_READ_TOKEN=your-server-only-genai-read-token

# Self-hosted database setup/update commands only; NEVER application variables.
# FIELDBOOK_SETUP_DATABASE_URL=postgresql://doadmin:password@your-db-host:25060/defaultdb
# FIELDBOOK_SETUP_DATABASE_CA=/private/path/cluster-ca.crt
# Backend service keys/passwords are generated separately; see docs/installation.md.
