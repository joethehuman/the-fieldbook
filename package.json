{
  "name": "fieldbook",
  "version": "0.1.0",
  "private": true,
  "license": "Elastic-2.0",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "node scripts/build-marker.mjs installed && next build --webpack",
    "start": "next start",
    "test": "node --import tsx --test tests/*.test.ts && node --conditions=react-server --import tsx --test tests/server/*.test.ts",
    "build:production": "pnpm build",
    "dev:production": "pnpm dev",
    "check:ui": "node scripts/check-ui.mjs",
    "check:providers": "node scripts/check-providers.mjs",
    "generate:mcp": "node --import tsx scripts/mcp-contract.ts",
    "check:mcp": "node --import tsx scripts/mcp-contract.ts --check",
    "test:ui": "playwright test",
    "test:authoring": "playwright test -c playwright.authoring.config.ts",
    "test:accounts": "playwright test -c playwright.accounts.config.ts",
    "test:search": "playwright test -c playwright.search.config.ts",
    "test:guests": "playwright test -c playwright.guests.config.ts",
    "test:reporting": "playwright test -c playwright.reporting.config.ts",
    "test:reading": "playwright test -c playwright.reading.config.ts",
    "test:og": "playwright test -c playwright.og.config.ts",
    "dev:demo": "pnpm --dir demo dev",
    "build:demo": "pnpm --dir demo build",
    "start:demo": "pnpm --dir demo start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p demo/tsconfig.json",
    "test:roster": "playwright test -c playwright.roster.config.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.129",
    "@lexical/list": "0.48.0",
    "@lexical/rich-text": "0.48.0",
    "@lexical/selection": "0.48.0",
    "@mdxeditor/editor": "4.2.5",
    "@mdxeditor/gurx": "1.2.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "ai": "7.0.126",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "jose": "^6.2.12",
    "lexical": "0.48.0",
    "lucide-react": "^0.468.0",
    "next": "^16.3.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "server-only": "^0.0.1",
    "streamdown": "2.7.0",
    "tailwind-merge": "^3.7.0",
    "tus-js-client": "4.3.1",
    "unified": "^11.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.5.0",
    "prettier": "^3.6.2",
    "serve": "^14.2.4",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": "22.x"
  }
}
