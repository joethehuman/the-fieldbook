server {
    listen 8080;
    server_name _;
    client_max_body_size 0;

    location = /health {
        return 200 'ready';
        add_header Content-Type text/plain;
    }

    # RFC 8414 inserts discovery before the issuer's /backend/auth/v1 path.
    location = /.well-known/oauth-authorization-server/backend/auth/v1 {
        proxy_pass ${FIELDBOOK_SUPABASE_INTERNAL_URL}/auth/v1/.well-known/oauth-authorization-server;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Studio and infrastructure administration are not exposed by this gateway.
    # Supabase's API authentication and storage authorization remain in force.
    location ~ ^/(auth/v1|rest/v1|storage/v1|\.well-known)(/|$) {
        proxy_pass ${FIELDBOOK_SUPABASE_INTERNAL_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Supabase Storage's resumable Location uses Kong's /storage/v1 prefix.
        # Restore this recipe's public /backend mount for the next upload chunk.
        proxy_redirect ~^https?://[^/]+(/storage/v1/.*)$ https://$host/backend$1;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    location / {
        return 404;
    }
}
